#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
APP_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
export TERMINAL_COMMIT_REPO="${TERMINAL_COMMIT_REPO:-$(pwd)}"

cd "$APP_DIR"
if [[ $# -eq 0 || "${1:-}" == "tui" ]]; then
  exec bun --preload @opentui/solid/preload "$APP_DIR/index.tsx"
fi

exec bun "$APP_DIR/cli.ts" "$@"
